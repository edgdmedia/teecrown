    "@payloadcms/ui": "3.85.0",
    "dotenv": "^16.6.1",
    "next": "16.2.12",
    "payload": "3.85.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.23.1"
  },
  "overrides": {
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
